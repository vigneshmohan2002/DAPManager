#!/bin/sh
# Fast pre-commit gate: byte-compile all Python so a syntax error never lands.
# Heavy integration tests run on pre-push instead (see .githooks/pre-push).
#
# Enable once per clone with:  git config core.hooksPath .githooks
PYTHON_BIN="${PYTHON_BIN:-}"
if [ -z "$PYTHON_BIN" ]; then
    PYTHON_BIN="$(command -v python3 || command -v python || true)"
fi
if [ -z "$PYTHON_BIN" ]; then
    echo "[pre-commit] FAILED: python3/python is required."
    exit 1
fi

echo "[pre-commit] byte-compiling Python sources..."
"$PYTHON_BIN" - <<'PY'
import compileall, sys
ok = 1
for target in ("src", "scripts", "tests"):
    ok &= compileall.compile_dir(target, quiet=1)
ok &= compileall.compile_file("web_server.py", quiet=1)
sys.exit(0 if ok else 1)
PY
rc=$?
if [ "$rc" != "0" ]; then
    echo "[pre-commit] FAILED: Python syntax error - fix before committing."
    exit 1
fi

echo "[pre-commit] running fast host unit tests (tests/unit)..."
PYTHONPATH=. "$PYTHON_BIN" -m unittest discover -s tests/unit -q
rc=$?
if [ "$rc" != "0" ]; then
    echo "[pre-commit] FAILED: unit tests did not pass."
    exit 1
fi

echo "[pre-commit] OK"
exit 0
