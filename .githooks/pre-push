#!/bin/sh
# Pre-push gate: run the full E2E suite (master + satellite containers) before
# code leaves the machine. Bypass for a one-off with:  SKIP_E2E=1 git push
#
# Enable once per clone with:  git config core.hooksPath .githooks
#
# Skips gracefully (exit 0) when the prerequisites for a real run aren't here —
# no Docker, or a clone without the local data/music library — so a fresh
# checkout can still push. The full run happens on the maintainer's machine.

if [ "${SKIP_E2E:-0}" = "1" ]; then
    echo "[pre-push] SKIP_E2E=1 set - skipping E2E suite."
    exit 0
fi

if ! command -v docker >/dev/null 2>&1; then
    echo "[pre-push] docker not found - skipping E2E suite."
    exit 0
fi

if [ ! -d "data/music" ]; then
    echo "[pre-push] no data/music library present - skipping E2E suite."
    exit 0
fi

echo "[pre-push] running full E2E suite (SKIP_E2E=1 git push to bypass)..."
PYTHON_BIN="${PYTHON_BIN:-}"
if [ -z "$PYTHON_BIN" ]; then
    PYTHON_BIN="$(command -v python3 || command -v python || true)"
fi
if [ -z "$PYTHON_BIN" ]; then
    echo "[pre-push] FAILED: python3/python is required."
    exit 1
fi
"$PYTHON_BIN" scripts/run_e2e.py --files 10
rc=$?
if [ "$rc" != "0" ]; then
    echo "[pre-push] FAILED: E2E suite did not pass - push aborted."
    exit 1
fi
echo "[pre-push] E2E suite passed."
exit 0
